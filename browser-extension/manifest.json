{
  "name": "Codex Textkorrektur",
  "version": "1.6.0",
  "manifest_version": 3,
  "description": "Textkorrektur mit der lokal verbundenen Codex-App.",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "incognito": "not_allowed",
  "key": ""
}
