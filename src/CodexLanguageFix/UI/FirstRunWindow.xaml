<Window x:Class="CodexLanguageFix.UI.FirstRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Language Fix"
        Width="470" Height="270"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="HeadingText"
               FontSize="22"
               FontWeight="SemiBold" />
    <StackPanel Grid.Row="1" Margin="0,18,0,18">
      <TextBlock x:Name="ExplanationText"
                 TextWrapping="Wrap"
                 FontSize="14" />
      <TextBlock x:Name="PrivacyText"
                 Margin="0,12,0,0"
                 TextWrapping="Wrap"
                 Foreground="#666666" />
    </StackPanel>
    <Button Grid.Row="2"
            x:Name="AcceptButton"
            Width="120" Height="34"
            HorizontalAlignment="Right"
            IsDefault="True"
            Click="Accept_OnClick" />
  </Grid>
</Window>
