<Window x:Class="CodexLanguageFix.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="500"
        SizeToContent="Height"
        MinHeight="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Focusable="True"
        FontFamily="Segoe UI Variable Text"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_OnPreviewKeyDown">
  <Grid Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock x:Name="HeadingText"
                 FontSize="22"
                 FontWeight="SemiBold" />

      <TextBlock x:Name="ShortcutHintText"
                 Margin="0,16,0,10"
                 TextWrapping="Wrap"
                 Foreground="#555555" />

      <TextBox x:Name="ShortcutDisplayTextBox"
               IsReadOnly="True"
               IsReadOnlyCaretVisible="True"
               FontSize="16"
               Padding="10,8"
               MinHeight="42"
               VerticalContentAlignment="Center"
               AutomationProperties.Name="Selected shortcut" />

      <StackPanel Orientation="Horizontal"
                  Margin="0,10,0,0">
        <Button x:Name="RecordButton"
                MinWidth="150"
                Height="34"
                Padding="12,4"
                Margin="0,0,8,0"
                Click="RecordButton_OnClick" />
        <Button x:Name="RestoreButton"
                MinWidth="150"
                Height="34"
                Padding="12,4"
                Click="RestoreButton_OnClick" />
      </StackPanel>

      <Border Margin="0,20,0,0"
              BorderBrush="#C8C8C8"
              BorderThickness="1"
              CornerRadius="4"
              Padding="12">
        <StackPanel>
          <TextBlock x:Name="LastStatusLabel"
                     FontWeight="SemiBold"
                     Margin="0,0,0,6" />
          <TextBox x:Name="StatusTextBox"
                   AcceptsReturn="True"
                   IsReadOnly="True"
                   IsReadOnlyCaretVisible="True"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Disabled"
                   MinHeight="84"
                   MaxHeight="160"
                   AutomationProperties.Name="Last status" />
        </StackPanel>
      </Border>

      <TextBlock x:Name="InlineMessageText"
                 Margin="0,12,0,0"
                 TextWrapping="Wrap"
                 Foreground="#B42318"
                 Visibility="Collapsed"
                 AutomationProperties.LiveSetting="Assertive" />
    </StackPanel>

    <StackPanel Grid.Row="1"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,22,0,0">
      <Button x:Name="SaveButton"
              MinWidth="100"
              Height="34"
              Padding="12,4"
              Margin="0,0,8,0"
              IsDefault="True"
              Click="SaveButton_OnClick" />
      <Button x:Name="CancelButton"
              MinWidth="100"
              Height="34"
              Padding="12,4"

              Click="CancelButton_OnClick" />
    </StackPanel>
  </Grid>
</Window>